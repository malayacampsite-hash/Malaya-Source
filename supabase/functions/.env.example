# ============================================================
# MALAYA CAMPSITE — SUPABASE EDGE FUNCTION LOCAL ENVIRONMENT
# ============================================================
# Hosted Supabase automatically injects:
#   SUPABASE_URL
#   SUPABASE_PUBLISHABLE_KEYS
#   SUPABASE_SECRET_KEYS
#
# Do NOT define a custom SUPABASE_SECRET_KEY here.
# The function uses @supabase/server with auth: 'secret'
# and ctx.supabaseAdmin for privileged database work.
#
# NEVER commit this file.
# ============================================================

# Google OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Google Sheets
GOOGLE_SHEET_ID=
GOOGLE_SHEET_RANGE=Bookings!A:O

# Gmail (not being activated in the first setup pass)
GMAIL_SENDER_EMAIL=malayacampsite@gmail.com

# Public website
MALAYA_PUBLIC_SITE_URL=https://malayacampsite.com
MALAYA_LOGO_URL=https://malayacampsite.com/images/logo.png
